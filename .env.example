# CodeChef Copilot Environment Configuration
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./codechef_copilot.db

# AI Provider Configuration (Optional: gemini, openai, anthropic, or leave empty for offline rule-based hints)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Execution Limits
EXECUTION_TIMEOUT_SECONDS=5
EXECUTION_MEMORY_MB=256
DOCKER_IMAGE_NAME=codechef-copilot-cpp:latest

# Browser Automation Profile
BROWSER_HEADLESS=false
BROWSER_PROFILE_DIR=./.codechef_profile
